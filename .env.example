# ============================================================
# CONFIGURACIÓN DEL DESPLIEGUE (docker-compose)
# Copie este archivo como `.env` y cambie los valores en
# producción. NUNCA suba el archivo `.env` a Git.
#
#   cp .env.example .env
#
# Para generar un JWT_SECRET seguro:
#   openssl rand -base64 48
#
# Comandos:
#   Desarrollo:  docker compose up -d --build
#   Producción:  docker compose -f docker-compose.prod.yml up -d --build
# ============================================================

# --- PostgreSQL -------------------------------------------------
# La contraseña DEBE ser alfanumérica (sin @, :, /, #) para no romper la URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=psicometrico

# --- Backend ----------------------------------------------------
# ⚠️ OBLIGATORIO en producción: el compose de producción NO arranca sin este
# valor (`${JWT_SECRET:?...}`) y el backend se niega a iniciar si usa el
# valor por defecto de desarrollo (fail-fast real). Genere uno con:
#   openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_en_produccion

# Origen(es) permitidos para CORS (separados por coma). El navegador solo
# acepta respuestas del backend si el origen de la página está listado aquí.
#   Desarrollo: http://localhost:5173
#   Producción: http://localhost:5173 o https://dominio-del-servidor
CORS_ORIGIN=http://localhost:5173

# --- Seed inicial (solo se ejecuta la primera vez con BD vacía) --
# Credenciales del usuario administrador inicial
SEED_ADMIN_EMAIL=admin@psicometrico.com
SEED_ADMIN_PASSWORD=Admin123!

# Credenciales del usuario evaluador inicial
SEED_EVALUADOR_EMAIL=evaluador@psicometrico.com
SEED_EVALUADOR_PASSWORD=Evaluador123!

# --- Frontend ---------------------------------------------------
# URL pública con la que el navegador alcanzará al backend.
# Si accede desde la misma máquina: http://localhost:3021
# Si accede desde otro equipo: http://IP_DEL_SERVIDOR:3021
#
# ⚠️ En producción (docker-compose.prod.yml) esta variable se inyecta en el
# BUILD de la imagen (el frontend se sirve como estáticos con Nginx).
# Si la cambia, reconstruya: docker compose -f docker-compose.prod.yml up -d --build
VITE_API_URL=http://localhost:3021
